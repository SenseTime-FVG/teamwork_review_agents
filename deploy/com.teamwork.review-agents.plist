<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.teamwork.review-agents</string>
  <key>ProgramArguments</key>
  <array>
    <string>/绝对路径/teamwork_review_agents/.venv/bin/teamwork-review-agents</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/绝对路径/teamwork_review_agents</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/绝对路径/teamwork_review_agents/data/service.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/绝对路径/teamwork_review_agents/data/service.stderr.log</string>
</dict>
</plist>
